    {
        "id": "transform-patient-list",
        "type": "function",
        "z": "flow-tab-3",
        "name": "Transform to Summary",
        "func": "const bundle = msg.payload;\nconst patients = [];\nif (bundle.entry) {\n    for (const entry of bundle.entry) {\n        const p = entry.resource;\n        if (p.resourceType !== 'Patient') continue;\n        const isGolden = (p.meta && p.meta.tag || []).some(t => t.display === 'Golden Record');\n        const name = p.name && p.name[0] ? `${(p.name[0].given || []).join(' ')} ${p.name[0].family || ''}`.trim() : 'Unknown';\n        patients.push({\n            id: p.id,\n            name: name,\n            gender: p.gender || 'unknown',\n            birthDate: p.birthDate || null,\n            isGoldenRecord: isGolden,\n            linkedPatients: (p.link || []).map(l => l.other.reference),\n            address: p.address && p.address[0] ? p.address[0].text || p.address[0].city : null\n        });\n    }\n}\nmsg.payload = { total: bundle.total || patients.length, patients: patients };\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 120,
        "wires": [
            [
                "respond-patients",
                "log-transformed"
            ]
        ]
    },
