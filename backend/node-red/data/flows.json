    {
        "id": "flow-tab-4",
        "type": "tab",
        "label": "CSV to FHIR (via OpenCR)",
        "disabled": false,
        "info": "Translates CSV → FHIR Patient → OpenHIM → OpenCR (deduplication). Processes patients sequentially and returns aggregated results."
    },
    {
        "id": "csv-http-in",
        "type": "http in",
        "z": "flow-tab-4",
        "name": "POST /import/csv/patients",
        "url": "/import/csv/patients",
        "method": "post",
        "upload": false,
        "x": 190,
        "y": 100,
        "wires": [
            [
                "csv-parse"
            ]
        ]
    },
    {
        "id": "csv-parse",
        "type": "csv",
        "z": "flow-tab-4",
        "name": "Parse CSV",
        "sep": ",",
        "hdrin": true,
        "hdrout": "none",
        "multi": "mult",
        "ret": "\\n",
        "temp": "",
        "skip": "0",
        "strings": true,
        "include_empty_strings": false,
        "include_null_values": false,
        "x": 390,
        "y": 100,
        "wires": [
            [
                "csv-to-fhir"
            ]
        ]
    },
    {
        "id": "csv-to-fhir",
        "type": "function",
        "z": "flow-tab-4",
        "name": "Translate to FHIR + Init Loop",
        "func": "const rows = msg.payload;\nconst patients = [];\nconst errors = [];\n\nfunction uuid() {\n    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n        var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);\n        return v.toString(16);\n    });\n}\n\nfor (let i = 0; i < rows.length; i++) {\n    const row = rows[i];\n    if (!row.last_name || !row.first_name) {\n        errors.push({ row: i+1, error: 'missing name' });\n        continue;\n    }\n    let gender = 'unknown';\n    const g = (row.gender || '').toLowerCase();\n    if (g === 'm' || g === 'male') gender = 'male';\n    else if (g === 'f' || g === 'female') gender = 'female';\n    \n    const id = uuid();\n    const patient = {\n        resourceType: 'Patient',\n        id: id,\n        meta: { profile: ['https://fhir.doh.gov.ph/phcore/StructureDefinition/ph-core-patient'] },\n        identifier: [{ system: 'http://openclientregistry.org/fhir/internalid', value: id }],\n        active: true,\n        name: [{ use: 'official', family: row.last_name.trim(), given: [row.first_name.trim()] }],\n        gender: gender\n    };\n    if (row.birthdate) patient.birthDate = row.birthdate.trim();\n    if (row.middle_name) patient.name[0].given.push(row.middle_name.trim());\n    if (row.barangay || row.city || row.province) {\n        patient.address = [{ use: 'home', city: (row.barangay || '').trim(), district: (row.city || '').trim(), state: (row.province || '').trim(), country: 'PH' }];\n    }\n    if (row.phone) patient.telecom = [{ system: 'phone', value: row.phone.trim(), use: 'mobile' }];\n    if (row.email) {\n        patient.telecom = patient.telecom || [];\n        patient.telecom.push({ system: 'email', value: row.email.trim(), use: 'home' });\n    }\n    patients.push(patient);\n}\n\n// Store state for sequential processing\nmsg._patients = patients;\nmsg._errors = errors;\nmsg._results = [];\nmsg._index = 0;\n\nnode.status({text: `${patients.length} patients to process`});\n\nif (patients.length === 0) {\n    msg.payload = { success: true, total: 0, created: 0, failed: 0, errors: errors, results: [] };\n    return [null, msg];\n}\n\n// Set up first patient\nmsg.payload = patients[0];\nmsg.headers = { 'Content-Type': 'application/fhir+json', 'Accept': 'application/fhir+json', 'x-openhim-clientid': 'chris-mobile' };\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 100,
        "wires": [
            [
                "post-to-openhim"
            ],
            [
                "csv-http-response"
            ]
        ]
    },
    {
        "id": "post-to-openhim",
        "type": "http request",
        "z": "flow-tab-4",
        "name": "POST to OpenHIM → OpenCR",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://openhim-core:5001/fhir/Patient",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": true,
        "headers": [
            {
                "keyType": "other",
                "keyValue": "Content-Type",
                "valueType": "other",
                "valueValue": "application/fhir+json"
            },
            {
                "keyType": "other",
                "keyValue": "Accept",
                "valueType": "other",
                "valueValue": "application/fhir+json"
            },
            {
                "keyType": "other",
                "keyValue": "x-openhim-clientid",
                "valueType": "other",
                "valueValue": "chris-mobile"
            }
        ],
        "x": 840,
        "y": 100,
        "wires": [
            [
                "process-response"
            ]
        ]
    },
    {
        "id": "process-response",
        "type": "function",
        "z": "flow-tab-4",
        "name": "Collect + Next",
        "func": "const idx = msg._index;\nconst patient = msg._patients[idx];\nconst name = `${patient.name[0].given[0]} ${patient.name[0].family}`;\nconst status = msg.statusCode || 0;\n\nmsg._results.push({\n    index: idx + 1,\n    name: name,\n    status: status,\n    success: status >= 200 && status < 300,\n    id: (msg.payload && msg.payload.id) || patient.id\n});\n\nnode.status({text: `${idx+1}/${msg._patients.length} - ${name}: ${status}`});\n\n// Move to next\nmsg._index = idx + 1;\n\nif (msg._index < msg._patients.length) {\n    // More patients to process\n    msg.payload = msg._patients[msg._index];\n    msg.headers = { 'Content-Type': 'application/fhir+json', 'Accept': 'application/fhir+json', 'x-openhim-clientid': 'chris-mobile' };\n    return [msg, null];\n} else {\n    // All done - build summary\n    const results = msg._results;\n    const created = results.filter(r => r.success).length;\n    const failed = results.filter(r => !r.success).length;\n    msg.payload = {\n        success: true,\n        total: msg._patients.length,\n        created: created,\n        failed: failed,\n        parseErrors: msg._errors,\n        results: results\n    };\n    return [null, msg];\n}",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 200,
        "wires": [
            [
                "post-to-openhim"
            ],
            [
                "log-final-result",
                "csv-http-response"
            ]
        ]
    },
    {
        "id": "log-final-result",
